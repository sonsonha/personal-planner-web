# Server-only connection from the web proxy to the Personal OS backend.
# Never expose PLANNER_WEB_TOKEN with a NEXT_PUBLIC_ prefix.
#
# Local web against deployed backend (recommended for dogfood):
# PLANNER_API_BASE_URL=https://soc-server-production.up.railway.app
# PLANNER_WEB_TOKEN=<same value as PLANNER_WEB_TOKEN on Railway>
#
# Local web against local backend:
# PLANNER_API_BASE_URL=http://localhost:3001
# PLANNER_WEB_TOKEN=<same value as backend/.env>
PLANNER_API_BASE_URL=https://soc-server-production.up.railway.app
# Production uses an Ed25519 PKCS#8 private key. Keep it server-only.
# PLANNER_WEB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Local development / Vercel dogfood may use the legacy shared token instead.
PLANNER_WEB_TOKEN=replace-with-the-same-32-character-token-used-by-the-backend
# ChatGPT Sites only: require oai-authenticated-* viewer headers (default off for Vercel).
# PLANNER_REQUIRE_CHATGPT_USER=1
